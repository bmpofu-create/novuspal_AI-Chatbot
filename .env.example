# transformers runs a model on this machine. ollama uses a local Ollama server.
LLM_BACKEND=transformers
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./chroma_data
USER_AGENT=NovusPalBot/0.1 (+contact: bmpofu@mtu.edu)
# Set to a long random string; required in the X-API-Key header for /ingest endpoints
ADMIN_API_KEY=change-me
# chroma (default, no setup) or pgvector (docker compose up -d db)
VECTOR_BACKEND=chroma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novuspal
# Comma-separated origins allowed to call the API from another site (leave empty for same-origin)
CORS_ORIGINS=
